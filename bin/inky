#!/usr/bin/env python3
"""Inky launcher (works from a checkout or a symlink in ~/.local/bin)."""

import os
import sys

ROOT = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
if ROOT not in sys.path:
    sys.path.insert(0, ROOT)

from inky.__main__ import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main())
